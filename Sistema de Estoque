    quantidade = input('Quantidade: ')
    preco = float(input('Preço: '))
    vendidos = int(input('Quantidade de vendido: '))

    estoque[produto] = { 'quantidade': quantidade,
        'preco unitário': preco,
        'quantidade de vendido': vendidos}

    print(estoque[produto])
